<Page x:Class="HumanResourcesManager.View.DepartmentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HumanResourcesManager.View" xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" xmlns:p="clr-namespace:HumanResourcesManager.Properties" xmlns:oxyplot="http://oxyplot.org/wpf" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="DepartmentsPage">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <CollectionViewSource x:Key="departmentsViewSource" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Encabezado con WrapPanel -->
        <DockPanel Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border BorderBrush="Black" BorderThickness="2" CornerRadius="8" MinWidth="200" Margin="8">
                    <StackPanel>
                        <Label Content="Total Departments:"></Label>
                        <TextBlock Text="{Binding Total}"></TextBlock>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="8">
                    <StackPanel>
                        <Label Content="{Binding Source={x:Static p:Resources.employeePerDepartment}}"></Label>
                        <oxyplot:PlotView Model="{Binding PlotModel}" MinHeight="350" MinWidth="400" Margin="4" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </DockPanel>

        <!-- Titulo de departamentos, Botón para agregar y CheckBox para modo edición -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0">
            <Label Content="Departments:" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="7,0">
            <Button Name="btnAddDepartment" Content="Add Department" Width="150" Margin="7,0" Click="btnAddDepartment_Click" />
            <!-- No hay modo de edición, pero podemos agregar una opción si es necesario -->
            <CheckBox Content="{Binding Source={x:Static p:Resources.editionMode}}" IsChecked="{Binding IsReadOnly}" VerticalAlignment="Center" />
            <Button Name="btnSaveChanges" Content="{Binding Source={x:Static p:Resources.saveChanges}}" Width="150" Margin="7,0" IsEnabled="{Binding Path=IsReadOnly}" Click="btnSaveChanges_Click"  VerticalAlignment="Center" />
        </StackPanel>

        <!-- Lista de departamentos -->
        <DataGrid x:Name="departmentsDataGrid" Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Source={StaticResource departmentsViewSource}}" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding name}" Header="Name" Width="*" />
                <DataGridTextColumn Binding="{Binding description}" Header="Description" Width="*" />

                <!-- Añadir botón de eliminar si es necesario -->
                <DataGridTemplateColumn Header="{Binding Source={x:Static p:Resources.delete}}" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="btnDeleteDepartment" Content="{Binding Source={x:Static p:Resources.delete}}" Width="75" Click="btnDeleteDepartment_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Page>
