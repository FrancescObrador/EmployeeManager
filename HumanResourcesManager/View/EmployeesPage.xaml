<Page x:Class="HumanResourcesManager.View.EmployeesPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HumanResourcesManager.View" 
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities"
      xmlns:oxyplot="http://oxyplot.org/wpf" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="EmployeesPage">
    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <CollectionViewSource x:Key="employeeViewSource" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border BorderBrush="Black" BorderThickness="2" CornerRadius="8" MinWidth="200" Margin="8">
                <StackPanel>
                    <Label Content="Total:"></Label>
                    <TextBlock Text="{Binding Total}"></TextBlock>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="8">
                <StackPanel>
                    <Label Content="Empleados por departamentos:"></Label>
                    <oxyplot:PlotView Model="{Binding PlotModel}" MinHeight="350" MinWidth="400" Margin="4"/>
                </StackPanel>
            </Border>
        </WrapPanel>


        <Label Grid.Row="1" Margin="7,0" Content="Empleados:" />
        <!--Lista de datos-->
        <DataGrid x:Name="employeesDataGrid" Grid.Row="2" ItemsSource="{Binding Source={StaticResource employeeViewSource}}" 
                  Margin="10" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="100">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Foto" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="100" Height="100" Source="{Binding picture, Converter={StaticResource BitmapImageConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding first_name}" Header="Nombre" Width="*" />
                <DataGridTextColumn Binding="{Binding last_name}" Header="Apellido" Width="*" />
                <DataGridTextColumn Binding="{Binding position}" Header="Cargo" Width="*" />
                <DataGridTextColumn Binding="{Binding email}" Header="Email" Width="*" />
                <DataGridTextColumn Binding="{Binding phone_number}" Header="Teléfono" Width="*" />
                <DataGridTextColumn Binding="{Binding hire_date}" Header="Fecha de contratación" Width="*" />
                <DataGridTextColumn Binding="{Binding salary}" Header="Salario" Width="*" />
                <DataGridTextColumn Binding="{Binding department.name}" Header="Departamento" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
