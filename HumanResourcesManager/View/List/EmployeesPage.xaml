<Page x:Class="HumanResourcesManager.View.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HumanResourcesManager.View"
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities"
      xmlns:p="clr-namespace:HumanResourcesManager.Properties"
      xmlns:oxyplot="http://oxyplot.org/wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeesPage">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <CollectionViewSource x:Key="employeeViewSource" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                BorderBrush="{StaticResource PrimaryBrush}" 
                BorderThickness="0 0 0 2"
                Margin="0 0 0 10"
                Padding="0 0 0 5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stats Container -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Border Background="{StaticResource LightBrush}" 
                            CornerRadius="5" 
                            Padding="15"
                            Margin="5">
                        <StackPanel>
                            <TextBlock Text="Total Employees" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0 0 0 5"/>
                            <TextBlock Text="{Binding Total}" 
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource LightBrush}" 
                            CornerRadius="5" 
                            Padding="15"
                            Margin="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static p:Resources.employeePerDepartment}}" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0 0 0 5"/>
                            <oxyplot:PlotView Model="{Binding PlotModel}" 
                                              Height="200" 
                                              Width="400"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="10 0">
                    <Button Name="btnAddEmployee" 
                            Content="Add Employee" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnAddEmployee_Click" 
                            Margin="5 0"/>

                    <CheckBox Content="{Binding Source={x:Static p:Resources.editionMode}}" 
                              IsChecked="{Binding IsReadOnly}" 
                              VerticalAlignment="Center"
                              Margin="10 0"
                              Foreground="{StaticResource TextBrush}"/>

                    <Button Name="btnSaveChanges" 
                            Content="{Binding Source={x:Static p:Resources.saveChanges}}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="btnSaveChanges_Click" 
                            Margin="5 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" 
                  x:Name="employeesDataGrid" 
                  ItemsSource="{Binding Source={StaticResource employeeViewSource}}"
                  Style="{StaticResource ModernDataGridStyle}"
                  MouseRightButtonDown="employeesDataGrid_MouseRightButtonDown"
                  IsReadOnly="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Photo" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Viewbox Stretch="Uniform">
                                <Image Width="100" 
                                       Height="100" 
                                       Source="{Binding picture, Converter={StaticResource BitmapImageConverter}}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                    <Image.Clip>
                                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                                    </Image.Clip>
                                </Image>
                            </Viewbox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding first_name}" 
                                    Header="{Binding Source={x:Static p:Resources.employeeFirstName}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding last_name}" 
                                    Header="{Binding Source={x:Static p:Resources.employeeLastName}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding position}" 
                                    Header="{Binding Source={x:Static p:Resources.employeePosition}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding email}" 
                                    Header="{Binding Source={x:Static p:Resources.employeeEmail}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding phone_number}" 
                                    Header="{Binding Source={x:Static p:Resources.employeePhoneNumber}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding hire_date}" 
                                    Header="{Binding Source={x:Static p:Resources.employeeHireDate}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding salary}" 
                                    Header="{Binding Source={x:Static p:Resources.employeeSalary}}" 
                                    Width="*"/>
                <DataGridTextColumn Binding="{Binding department.name}" 
                                    Header="{Binding Source={x:Static p:Resources.employeeDepartment}}" 
                                    Width="*"/>

                <DataGridTemplateColumn Header="{Binding Source={x:Static p:Resources.delete}}" 
                                       Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="btnDeleteEmployee" 
                                    Content="{Binding Source={x:Static p:Resources.delete}}" 
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="btnDeleteEmployee_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>