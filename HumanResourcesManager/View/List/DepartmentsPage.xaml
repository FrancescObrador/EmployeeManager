<Page x:Class="HumanResourcesManager.View.DepartmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HumanResourcesManager.View"
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities"
      xmlns:p="clr-namespace:HumanResourcesManager.Properties"
      xmlns:oxyplot="http://oxyplot.org/wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DepartmentsPage">

    <Page.Resources>
        <CollectionViewSource x:Key="departmentsViewSource" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                BorderBrush="{StaticResource PrimaryBrush}" 
                BorderThickness="0 0 0 2"
                Margin="0 0 0 10"
                Padding="0 0 0 5">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource LightBrush}" 
                        CornerRadius="5" 
                        Padding="15"
                        Margin="5">
                    <StackPanel>
                        <TextBlock Text="Total Departments" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0 0 0 5"/>
                        <TextBlock Text="{Binding Total}" 
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource LightBrush}" 
                        CornerRadius="5" 
                        Padding="15"
                        Margin="5">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static p:Resources.employeePerDepartment}}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0 0 0 5"/>
                        <oxyplot:PlotView Model="{Binding PlotModel}" 
                                          Height="200" 
                                          Width="400"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" 
                  x:Name="departmentsDataGrid" 
                  ItemsSource="{Binding Source={StaticResource departmentsViewSource}}"
                  Style="{StaticResource ModernDataGridStyle}"
                  MouseRightButtonDown="departmentsDataGrid_MouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding name}" 
                                     Header="Name" 
                                     Width="*"/>
                <DataGridTextColumn Binding="{Binding description}" 
                                     Header="Description" 
                                     Width="*"/>

                <DataGridTemplateColumn Header="{Binding Source={x:Static p:Resources.delete}}" 
                                       Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="btnDeleteDepartment" 
                                    Content="{Binding Source={x:Static p:Resources.delete}}" 
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="btnDeleteDepartment_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>