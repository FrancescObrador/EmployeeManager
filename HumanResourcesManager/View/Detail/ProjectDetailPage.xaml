<Page x:Class="HumanResourcesManager.View.Detail.ProjectDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" 
      xmlns:p="clr-namespace:HumanResourcesManager.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="800" 
      d:DesignWidth="1200"
      Title="ProjectDetailPage"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="DetailGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource LightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DetailDataGridStyle" TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Sección de Detalles del Proyecto -->
        <ScrollViewer Grid.Row="0" Grid.Column="1"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0 0 0 20">
            <StackPanel>
                <!-- Información General -->
                <GroupBox Header="{Binding Source={x:Static p:Resources.generalInfo}}"
                         Style="{StaticResource DetailGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="{Binding Source={x:Static p:Resources.projectName}}"
                                  Margin="0 0 15 0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                  Text="{Binding SelectedProject.name}"
                                  FontWeight="Normal"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                  Text="{Binding Source={x:Static p:Resources.projectDescription}}"
                                  Margin="0 10 15 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                  Text="{Binding SelectedProject.description}"
                                  FontWeight="Normal"
                                  TextWrapping="Wrap"
                                  Margin="0 10 0 0"/>
                    </Grid>
                </GroupBox>

                <!-- Fechas -->
                <GroupBox Header="{Binding Source={x:Static p:Resources.dates}}"
                         Style="{StaticResource DetailGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="{Binding Source={x:Static p:Resources.projectStartDate}}"
                                  Margin="0 0 15 0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                  Text="{Binding SelectedProject.start_date, StringFormat=d}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                  Text="{Binding Source={x:Static p:Resources.projectEndDate}}"
                                  Margin="0 10 15 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                  Text="{Binding SelectedProject.end_date, StringFormat=d}"
                                  Margin="0 10 0 0"/>
                    </Grid>
                </GroupBox>

                <!-- Datos Económicos -->
                <GroupBox Header="{Binding Source={x:Static p:Resources.data}}"
                         Style="{StaticResource DetailGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="{Binding Source={x:Static p:Resources.projectBudget}}"
                                  Margin="0 0 15 0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                  Text="{Binding SelectedProject.budget, StringFormat=C}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                  Text="{Binding Source={x:Static p:Resources.projectStatus}}"
                                  Margin="0 10 15 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                  Text="{Binding SelectedProject.status}"
                                  Margin="0 10 0 0"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Lista de Empleados -->
        <DataGrid Grid.Row="2" Grid.ColumnSpan="2"
                 ItemsSource="{Binding SelectedProject.EmployeeProjects}"
                 Style="{StaticResource DetailDataGridStyle}"
                 Margin="0 15 0 0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeeName}}" 
                                   Binding="{Binding employee.FullName}" 
                                   Width="*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeePosition}}" 
                                   Binding="{Binding role}" 
                                   Width="*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.projectStartDate}}" 
                                   Binding="{Binding start_date, StringFormat=d}" 
                                   Width="*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.projectEndDate}}" 
                                   Binding="{Binding end_date, StringFormat=d}" 
                                   Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0 0 0 15">
            <Button x:Name="btnBack" 
                   Content="{Binding Source={x:Static p:Resources.Return}}" 
                   Style="{StaticResource SecondaryButtonStyle}"
                   Width="120"
                   Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>