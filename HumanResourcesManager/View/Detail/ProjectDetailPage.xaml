<Page x:Class="HumanResourcesManager.View.Detail.ProjectDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HumanResourcesManager.View.Detail"
      mc:Ignorable="d" 
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" 
      xmlns:p="clr-namespace:HumanResourcesManager.Properties" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectDetailPage">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>

        <!-- Project Details -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Name -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProject.name}" />
            
            <!-- Description -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProject.description}" />

            <!-- Start Date -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Date:" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProject.start_date}" />

            <!-- End Date -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="End Date:" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject.end_date}" />

            <!-- Budget -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Budget:" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProject.budget}" />

            <!-- Status -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Status:" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProject.status}" />
        </Grid>

        <!-- Employee List -->
        <DataGrid Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedProject.EmployeeProjects}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee Name" Binding="{Binding employee.FullName}" Width="*" />
                <DataGridTextColumn Header="Role" Binding="{Binding role}" Width="*" />
                <DataGridTextColumn Header="Start Date" Binding="{Binding start_date}" Width="*" />
                <DataGridTextColumn Header="End Date" Binding="{Binding end_date}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnBack" Content="Return" Width="100" Click="btnBack_Click" />
        </StackPanel>
    </Grid>
</Page>
