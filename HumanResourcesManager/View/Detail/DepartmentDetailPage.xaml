<Page x:Class="HumanResourcesManager.View.Detail.DepartmentDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" 
      xmlns:p="clr-namespace:HumanResourcesManager.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="800" 
      d:DesignWidth="1200"
      Title="Department Details"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
    </Page.Resources>

    <Grid Margin="20 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Sección izquierda - Información del departamento -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                Margin="0 0 20 0"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource LightBrush}"
                BorderThickness="1"
                Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Detalles del departamento -->
                    <GroupBox Header="{Binding Source={x:Static p:Resources.departmentsTitle}}"
                            FontSize="16"
                            Margin="0 0 0 10">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static p:Resources.projectName}}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedDepartment.name}"
                                       Margin="0 5 0 0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding Source={x:Static p:Resources.projectDescription}}"
                            Margin="0 0 0 10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                    MaxHeight="200">
                            <TextBlock Text="{Binding SelectedDepartment.description}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Lista de empleados -->
        <Border Grid.Row="0" Grid.Column="1"
                Margin="0 0 0 15"
                CornerRadius="8"
                BorderBrush="{StaticResource LightBrush}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding SelectedDepartment.Employees}" 
                    Style="{StaticResource ModernDataGridStyle}"
                    AutoGenerateColumns="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeeFirstName}}" 
                                      Binding="{Binding first_name}"
                                      Width="2*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeeLastName}}" 
                                      Binding="{Binding last_name}"
                                      Width="2*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeePosition}}" 
                                      Binding="{Binding position}"
                                      Width="2*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeeEmail}}" 
                                      Binding="{Binding email}"
                                      Width="3*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.employeePhoneNumber}}" 
                                      Binding="{Binding phone_number}"
                                      Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                  Orientation="Horizontal" 
                  HorizontalAlignment="Right"
                  Margin="0 15 0 0">
            <Button x:Name="btnBack" 
                  Content="{Binding Source={x:Static p:Resources.Return}}" 
                  Style="{StaticResource SecondaryButtonStyle}"
                  MinWidth="160"
                  Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>