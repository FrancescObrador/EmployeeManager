<Page x:Class="HumanResourcesManager.View.Detail.DepartmentDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HumanResourcesManager.View.Detail" 
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" 
      xmlns:p="clr-namespace:HumanResourcesManager.Properties" mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DepartmentDetailPage">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>

        <!-- Department Details -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Name -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.departmentsTitle}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDepartment.name}" />

            <!-- Description -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.projectDescription}}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDepartment.description}" />
        </Grid>

        <!-- Employees List -->
        <DataGrid Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedDepartment.Employees}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="First Name" Binding="{Binding first_name}" Width="*" />
                <DataGridTextColumn Header="Last Name" Binding="{Binding last_name}" Width="*" />
                <DataGridTextColumn Header="Position" Binding="{Binding position}" Width="*" />
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*" />
                <DataGridTextColumn Header="Phone Number" Binding="{Binding phone_number}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnBack" Content="{Binding Source={x:Static p:Resources.Return}}" Width="100" Click="btnBack_Click" />
        </StackPanel>
    </Grid>
</Page>
