<Page x:Class="HumanResourcesManager.View.EmployeeDetailPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" 
      xmlns:oxyplot="http://oxyplot.org/wpf"
      xmlns:p="clr-namespace:HumanResourcesManager.Properties"  
      mc:Ignorable="d" 
      d:DesignHeight="800" 
      d:DesignWidth="1200" 
      Title="Employee Detail"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Page.Resources>

    <Grid Margin="20 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Sección izquierda - Foto y Gráfico -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                Margin="0 0 20 0"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource LightBrush}"
                BorderThickness="1"
                Padding="15">
            <StackPanel>
                <Border CornerRadius="8" 
                        BorderBrush="{StaticResource LightBrush}" 
                        BorderThickness="1"
                        Padding="4"
                        Margin="0 0 0 15">
                    <Image Width="200" Height="200" 
                           Source="{Binding Employee.picture, Converter={StaticResource BitmapImageConverter}}"
                           Stretch="UniformToFill"/>
                </Border>

                <Border CornerRadius="8"
                        BorderBrush="{StaticResource LightBrush}"
                        BorderThickness="1"
                        Padding="4">
                    <oxyplot:PlotView Model="{Binding PlotModel}" 
                                    MinHeight="300" 
                                    Background="Transparent"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sección derecha - Detalles del empleado -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="0 0 0 15">
            <StackPanel>
                <GroupBox Header="{Binding Source={x:Static p:Resources.employeeName}}"
                          FontSize="16"
                          Margin="0 0 0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeeFirstName}}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Employee.first_name}"
                                   Margin="10 0 0 0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeeLastName}}"
                                   Margin="0 10 0 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Employee.last_name}"
                                   Margin="10 10 0 0"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="{Binding Source={x:Static p:Resources.employeeContactInfo}}"
                          Margin="0 0 0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeeEmail}}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Employee.email}"
                                   Margin="10 0 0 0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeePhoneNumber}}"
                                   Margin="0 10 0 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Employee.phone_number}"
                                   Margin="10 10 0 0"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="{Binding Source={x:Static p:Resources.employeeEmploymentInfo}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeeHireDate}}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Employee.hire_date}"
                                   Margin="10 0 0 0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeeSalary}}"
                                   Margin="0 10 0 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Employee.salary, StringFormat=C}"
                                   Margin="10 10 0 0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Source={x:Static p:Resources.employeeDepartment}}"
                                   Margin="0 10 0 0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Employee.department.name}"
                                   Margin="10 10 0 0"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Nóminas -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="0 0 0 15"
                CornerRadius="8"
                BorderBrush="{StaticResource LightBrush}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Employee.Payrolls}" 
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.payDay}}" 
                                       Binding="{Binding pay_date, StringFormat=d}"
                                       Width="2*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.grossSalary}}" 
                                       Binding="{Binding gross_salary, StringFormat=C}"
                                       Width="1.5*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.deductions}}" 
                                       Binding="{Binding deductions, StringFormat=C}"
                                       Width="1.5*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.netSalary}}" 
                                       Binding="{Binding net_salary, StringFormat=C}"
                                       Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0 15 0 0">
            <Button x:Name="btnPDF" 
                    Content="{Binding Source={x:Static p:Resources.generatePayroll}}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="160"
                    Click="btnPDF_Click"
                    Margin="0 0 10 0"/>

            <Button x:Name="btnBack" 
                    Content="{Binding Source={x:Static p:Resources.Return}}" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="btnBack_Click"
                    MinWidth="160"/>
        </StackPanel>
    </Grid>
</Page>