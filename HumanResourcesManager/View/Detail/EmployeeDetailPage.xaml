<Page x:Class="HumanResourcesManager.View.EmployeeDetailPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities"
      xmlns:p="clr-namespace:HumanResourcesManager.Properties"  
      mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="EmployeePage">

    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>

        <!-- Employee Photo -->
        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Width="200" Height="200" 
                   Source="{Binding SelectedEmployee.picture, Converter={StaticResource BitmapImageConverter}}" />
        </StackPanel>

        <!-- Employee Details -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Name -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeeFirstName}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEmployee.first_name}" />
            
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeeLastName}}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEmployee.last_name}" />

            <!-- Position -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeePosition}}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEmployee.position}" />

            <!-- Contact Info -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeeEmail}}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEmployee.email}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeePhoneNumber}}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEmployee.phone_number}" />

            <!-- Employment Info -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeeHireDate}}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEmployee.hire_date}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeeSalary}}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedEmployee.salary}" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding Source={x:Static p:Resources.employeeDepartment}}" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedEmployee.department.name}" />
        </Grid>

        <!-- Payroll List -->
        <DataGrid Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedEmployee.Payrolls}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pay date" Binding="{Binding pay_date}" Width="*" />
                <DataGridTextColumn Header="Gross Salary" Binding="{Binding gross_salary}" Width="*" />
                <DataGridTextColumn Header="Deductions" Binding="{Binding deductions}" Width="*" />
                <DataGridTextColumn Header="Net Salary" Binding="{Binding net_salary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid> 

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnPDF" Content="{Binding Source={x:Static p:Resources.generatePayroll}}" Width="100" Click="btnPDF_Click"  />
            <Separator></Separator>
            <Button x:Name="btnBack" Content="{Binding Source={x:Static p:Resources.Return}}" Width="100" Click="btnBack_Click" />
        </StackPanel>
    </Grid>
</Page>
