<Page x:Class="HumanResourcesManager.View.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HumanResourcesManager.View"
      xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities" d:DesignHeight="450" d:DesignWidth="800"
      xmlns:oxyplot="http://oxyplot.org/wpf"
      mc:Ignorable="d" 
      Title="ProjectsPage">
    <Page.Resources>
        <utilities:BitmapImageConverter x:Key="BitmapImageConverter" />
        <CollectionViewSource x:Key="projectsViewSource" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border BorderBrush="Black" BorderThickness="2" CornerRadius="8" MinWidth="200" Margin="8">
                <StackPanel>
                    <Label Content="Total:"></Label>
                    <TextBlock Text="{Binding Total}"></TextBlock>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="8">
                <StackPanel>
                    <Label Content="Empleados por proyecto:"></Label>
                    <oxyplot:PlotView Model="{Binding PlotModel}" MinHeight="350" MinWidth="400" Margin="4" />
                </StackPanel>
            </Border>
        </WrapPanel>


        <Label Grid.Row="1" Margin="7,0" Content="Empleados:" />
        <!--Lista de datos-->
        <DataGrid x:Name="employeesDataGrid" Grid.Row="2" ItemsSource="{Binding Source={StaticResource projectsViewSource}}" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="100">
            <DataGrid.Columns>
                
                <DataGridTextColumn Binding="{Binding name}" Header="Nombre del Proyecto" Width="*" />
                <DataGridTextColumn Binding="{Binding description}" Header="Descripción" Width="*" />
                <DataGridTextColumn Binding="{Binding start_date}" Header="Fecha de Inicio" Width="*" />
                <DataGridTextColumn Binding="{Binding end_date}" Header="Fecha de Fin" Width="*" />
                <DataGridTextColumn Binding="{Binding budget}" Header="Presupuesto" Width="*" />
                <DataGridTextColumn Binding="{Binding status}" Header="Estado" Width="*" />

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
