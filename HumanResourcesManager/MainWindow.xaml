<Window x:Class="HumanResourcesManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanResourcesManager"
        
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Euryst" Height="450" Width="800">
    
    <DockPanel>
        <!-- Barra superior -->
        <ToolBar DockPanel.Dock="Top">
            <!--<Button Content="Archivo" />
            <Button Content="Editar" />
            <Button Content="Ayuda" />-->
        </ToolBar>

        <!-- Barra lateral izquierda -->
        <StackPanel DockPanel.Dock="Left" Background="LightGray" Width="200">
            <Button x:Name="btnPageOne" Content="Opción 1" Margin="5" Click="btnPageOne_Click" />
            <Button x:Name="btnPageTwo" Content="Opción 2" Margin="5" Click="btnPageTwo_Click" />
            <Button x:Name="btnPageThree" Content="Opción 3" Margin="5" Click="btnPageThree_Click" />
        </StackPanel>

        <!-- Contenido principal -->
        <Frame x:Name="mainFrame"></Frame>
    </DockPanel>
</Window>
