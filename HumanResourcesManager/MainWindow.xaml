<Window x:Class="HumanResourcesManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanResourcesManager"
        xmlns:utilities="clr-namespace:HumanResourcesManager.Utilities"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Euryst" Height="450" Width="800">
    <Window.Resources>
        <utilities:BitmapImageConverter x:Key="ByteArrayToImageConverter" />
    </Window.Resources>
    <DockPanel>
        <!-- Barra superior -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Archivo" />
            <Button Content="Editar" />
            <Button Content="Ayuda" />
        </ToolBar>

        <!-- Barra lateral izquierda -->
        <StackPanel DockPanel.Dock="Left" Background="LightGray" Width="200">
            <Button Content="Opción 1" Margin="5" />
            <Button Content="Opción 2" Margin="5" />
            <Button Content="Opción 3" Margin="5" />
        </StackPanel>

        <!-- Contenido principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Lista de empleados -->
            <ListBox Grid.Row="0" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"> 
                            <Image Source="{Binding picture, Converter={StaticResource ByteArrayToImageConverter}}" />
                            <TextBlock Text="{Binding first_name}" />
                            <TextBlock Text="{Binding last_name}" />
                            <TextBlock Text="{Binding position}" />
                            <TextBlock Text="{Binding email}"  />
                            <TextBlock Text="{Binding phone_number}"/>
                            <TextBlock Text="{Binding hire_date}"  />
                            <TextBlock Text="{Binding salary}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
